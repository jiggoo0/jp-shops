{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "project": ["**/*.{ts,tsx}"],
  "entry": [
    "app/**/*.{ts,tsx}",
    "components/**/*.{ts,tsx}",
    "config/**/*.{ts,tsx}",
    "constants/**/*.{ts,tsx}",
    "scripts/**/*.mjs"
  ],
  "ignoreDependencies": [
    "eslint-config-next",
    "autoprefixer",
    "postcss-load-config"
  ],
  "ignoreExportsUsedInFile": true
}
